# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# ---------------------------------------------------------------------------
# React Native / Expo / native toolchains
# ---------------------------------------------------------------------------

# Expo prebuild output. Regenerated by `expo prebuild --clean`, never hand-edited —
# any native change belongs in a package's ios//android/ or in a config plugin.
apps/*/ios/
apps/*/android/
apps/*/.expo/
.expo/
expo-env.d.ts
.metro-health-check*

# CocoaPods / Xcode
Pods/
*.xcworkspace
!*.xcodeproj/project.xcworkspace
xcuserdata/
DerivedData/
*.xcuserstate
*.hmap
*.ipa
*.dSYM.zip

# Gradle / Android
.gradle/
.cxx/
packages/*/android/build/
local.properties
*.keystore
!debug.keystore

# React Native codegen output. A build artifact — unlike nitrogen, this is regenerated
# on every pod install / Gradle sync and must never be committed.
packages/*/android/generated/
**/build/generated/ios/

# react-native-builder-bob output
lib/

# SwiftPM (the contract-test harness in packages/*/Package.swift)
.build/
.swiftpm/

# NOTE: packages/*/ios/Generated/ is deliberately NOT ignored. That Swift model is generated
# from src/tree.ts but committed, so `pod install` never needs Node and a schema change shows
# up in a diff. `npm run verify` fails if it is stale.
